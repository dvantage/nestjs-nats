{
  "name": "@dvantage/nestjs-nats",
  "version": "0.0.0",
  "description": "NATS JetStream events and NATS RPC for NestJS services",
  "author": "Vladimir Dorogov",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/nats-core": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/microservices": "^12.0.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nats-io/jetstream": "^3.5.0",
    "@nats-io/nats-core": "^3.5.0",
    "@nats-io/transport-node": "^3.5.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/microservices": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dvantage/nestjs-nats.git"
  }
}
